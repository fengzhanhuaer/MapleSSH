if(NOT MAPLE_WX_SOURCE OR NOT EXISTS "${MAPLE_WX_SOURCE}/CMakeLists.txt")
    message(FATAL_ERROR "Run scripts/prepare-deps.ps1 and set MAPLE_WX_SOURCE to the verified wxWidgets distribution")
endif()
set(wxBUILD_SHARED OFF CACHE BOOL "" FORCE)
set(wxBUILD_USE_STATIC_RUNTIME ON CACHE BOOL "" FORCE)
set(wxBUILD_SAMPLES OFF CACHE BOOL "" FORCE)
set(wxBUILD_DEMOS OFF CACHE BOOL "" FORCE)
set(wxBUILD_TESTS OFF CACHE BOOL "" FORCE)
set(wxUSE_WEBVIEW OFF CACHE BOOL "" FORCE)
set(wxUSE_MEDIACTRL OFF CACHE BOOL "" FORCE)
set(wxUSE_STC OFF CACHE BOOL "" FORCE)
set(wxUSE_RICHTEXT OFF CACHE BOOL "" FORCE)
set(wxUSE_RIBBON OFF CACHE BOOL "" FORCE)
set(wxUSE_PROPGRID OFF CACHE BOOL "" FORCE)
set(wxUSE_HTML OFF CACHE BOOL "" FORCE)
set(wxUSE_HELP OFF CACHE BOOL "" FORCE)
set(wxUSE_WXHTML_HELP OFF CACHE BOOL "" FORCE)
set(wxUSE_MS_HTML_HELP OFF CACHE BOOL "" FORCE)
set(wxUSE_LIBTIFF OFF CACHE STRING "" FORCE)
set(wxUSE_LIBJPEG OFF CACHE STRING "" FORCE)
set(wxUSE_AUI ON CACHE BOOL "" FORCE)
set(wxBUILD_PRECOMP ON CACHE BOOL "" FORCE)
add_subdirectory("${MAPLE_WX_SOURCE}" "${CMAKE_BINARY_DIR}/wxwidgets" EXCLUDE_FROM_ALL)
set(vterm_source "${MAPLE_DOWNLOADS}/libvterm-0.3.3")
if(NOT EXISTS "${vterm_source}/include/vterm.h")
    message(FATAL_ERROR "Missing verified libvterm source; run scripts/prepare-deps.ps1")
endif()
file(GLOB vterm_sources CONFIGURE_DEPENDS "${vterm_source}/src/*.c")
add_library(maple_vterm STATIC ${vterm_sources})
target_include_directories(maple_vterm PUBLIC "${vterm_source}/include")
target_compile_definitions(maple_vterm PRIVATE _CRT_SECURE_NO_WARNINGS)
