{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build",
      "cacheVariables": {
        "MAPLE_DEPS_ONLY": false,
        "MAPLE_BUILD_GUI": true,
        "OPENSSL_ROOT_DIR": {
          "type": "PATH",
          "value": "${sourceDir}/out/openssl"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "MapleSSH Release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "displayName": "MapleSSH Release Tests",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
